# Supabase project credentials — copy this file to .env.local and fill in.
# IMPORTANT: leave values empty until you have real keys. A placeholder URL
# makes the app try (and fail) to reach Supabase instead of using demo data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key is used ONLY server-side (API routes / webhooks). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: AI concierge + AI case-study drafts (free key at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Optional: your deployed URL (used for metadata/OG tags)
NEXT_PUBLIC_SITE_URL=

# Media storage — admin image uploads go to Cloudinary (cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
# Get it from https://cloudinary.com/console → Dashboard → API Environment Variable
CLOUDINARY_URL=

# Brevo (Sendinblue) transactional email — admin alerts + client auto-reply + newsletter
# Get a key at https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=
BREVO_FROM_EMAIL=hello@yourdomain.com
BREVO_FROM_NAME=Your Brand
